# WhatsApp Webhook Gateway — Petrobind Global
# Copy this file to `.env` and fill in real values. NEVER commit `.env` itself.

# ---------------------------------------------------------------------------
# 1. Meta — WhatsApp Business Platform (Cloud API)
# ---------------------------------------------------------------------------

# Verify token for GET /webhook handshake — this is the SAME string you paste
# into Meta App Dashboard → WhatsApp → Configuration → Webhook → Verify token.
WHATSAPP_VERIFY_TOKEN=waba_verify_8f3kLm2Qp7xR9tVz4nHy6cXb1Nw0eAjM

# Long-lived System User access token. Meta Business Settings → System Users →
# your system user → Add Assets → this App → Generate Token (no expiry).
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token_here

# The ID of the registered WhatsApp phone number (from the "Getting started" page).
WHATSAPP_PHONE_NUMBER_ID=1095503950307611

# Your WhatsApp Business Account ID (WABA ID).
WHATSAPP_BUSINESS_ACCOUNT_ID=2012136743038729

# Meta App Dashboard → Settings → Basic → App Secret. Used to verify the
# X-Hub-Signature-256 header on every inbound /webhook POST — WITHOUT this
# set, anyone who finds the webhook URL can POST forged WhatsApp messages:
# real LLM API cost per message, spam lead/handoff emails, and outbound
# WhatsApp sends billed to this business number, with no proof any of it
# came from Meta. Strongly recommended to set this.
WHATSAPP_APP_SECRET=your_meta_app_secret_from_app_dashboard_settings_basic

# Graph API version. Bump when Meta deprecates the current version.
WHATSAPP_API_VERSION=v22.0

# Once Meta approves your follow-up message template, set its name here.
# Example: follow_up_inquiry (template variables: {{product}})
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=

# ---------------------------------------------------------------------------
# 2. OpenAI — embeddings only (RAG index build + runtime query embedding)
# ---------------------------------------------------------------------------
# Chat completions go through OpenRouter (cheaper). Embeddings are ONLY used
# by rag/retrieve.py and scripts/build_index.py via text-embedding-3-small.
# Get from: https://platform.openai.com/api-keys  (OpenAI account required)
OPENAI_API_KEY=REPLACE_OPENAI_API_KEY_FORMAT_SK_PROJ_THEN_RANDOM_CHARS_FOR_EMBEDDINGS_ONLY

# ---------------------------------------------------------------------------
# 3. OpenRouter — chat completions (LLM replies to buyers on WhatsApp)
# ---------------------------------------------------------------------------
# Grab a key from https://openrouter.ai/keys . Default model =
# openai/gpt-5-mini (upgraded from gpt-5-nano 2026-09-22 — nano was
# unreliable in production: ignored formatting rules, hallucinated what
# the buyer had said earlier in the conversation).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_API_KEY_FROM_OPENROUTER_DOT_AI_SLASH_KEYS
OPENROUTER_MODEL=openai/gpt-5-mini

# ---------------------------------------------------------------------------
# 4. SMTP — lead / handoff / booking notification emails to sales
#    IMPORTANT (2026-09-22): Spacemail (mail.spacemail.com) is confirmed
#    BLOCKED from Render on both port 465 and 587 — TimeoutError at the
#    network level, same credentials work fine from a local machine. This
#    is a known category of PaaS outbound-SMTP restriction, not a Spacemail
#    or credentials problem. Gmail SMTP is used instead below since it
#    reaches Render successfully. If you ever move off Render, or Render's
#    network policy changes, Spacemail can be swapped back in (same
#    SMTP_HOST/PORT/USERNAME/PASSWORD shape, see notify.py's docstring).
#    Longer-term, a proper HTTPS transactional email API (Resend, SendGrid)
#    would be more robust than any SMTP provider on a PaaS host, since
#    HTTPS (443) is essentially never blocked the way SMTP ports are.
# ---------------------------------------------------------------------------
# Provider quick-select — changes the SMTP_HOST/SMTP_PORT defaults if those
# env vars are not explicitly set:
#   "spacemail" / "privateemail" / "namecheap" → mail.spacemail.com:465 (SSL implicit)
#   "gmail" → smtp.gmail.com:587 (STARTTLS, App Password required, 2FA must be ON)
#   Any other string → mail.spacemail.com:465 (default)
SMTP_HOST_PROVIDER=gmail

# Gmail SMTP (works from Render). Requires a Gmail App Password, NOT your
# normal account password — generate one at
# https://myaccount.google.com/apppasswords (2-Step Verification must be
# enabled on the account first, or app passwords aren't offered at all and
# Google returns "535 Bad credentials" regardless of what you enter).
# Gmail requires the From address to match the authenticated account, so
# notifications send from your Gmail address, not sales@petrobindglobal.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password_no_spaces

# Email address notifications are sent FROM (usually equals SMTP_USERNAME).
NOTIFY_FROM_EMAIL=your_gmail_address@gmail.com
# The sales / trading desk inbox that receives all new lead/handoff emails.
# You can list multiple addresses separated by commas (no spaces).
SALES_EMAIL=milly.phua@petrobindglobal.com

# Optional, local/manual testing only. When set to 1/true, notify.py prints
# what it WOULD have emailed instead of actually sending it, so test runs
# (curl scripts, python smoke tests, persona testing) never leak into the
# real sales inbox. Leave unset (or 0) on Render / production so real leads
# actually get emailed.
NOTIFY_DRY_RUN=0

# ---------------------------------------------------------------------------
# 4b. SMTP setup verification — run this in a shell to confirm credentials work
#     BEFORE deploying to Render. Does NOT send a real email, only logs in.
#
#   cd ~/AI\ development/whatsapp-webhook-gateway
#   source .venv/bin/activate
#   python3 - <<'PY'
#   import smtplib, ssl, os
#   from dotenv import load_dotenv; load_dotenv()
#   host, port = os.environ["SMTP_HOST"], int(os.environ["SMTP_PORT"])
#   user, pw = os.environ["SMTP_USERNAME"], os.environ["SMTP_PASSWORD"]
#   ctx = ssl.create_default_context()
#   if port == 465:
#     with smtplib.SMTP_SSL(host, port, context=ctx, timeout=20) as s:
#       s.login(user, pw); print("SMTP OK (SSL 465). login user:", user)
#   else:
#     with smtplib.SMTP(host, port, timeout=20) as s:
#       s.starttls(context=ctx); s.login(user, pw); print(f"SMTP OK (STARTTLS {port}). login user:", user)
#   PY
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 4c. (Optional) Follow-up cron endpoint bearer auth
# ---------------------------------------------------------------------------
# /followups-scan accepts a Bearer token so only your cron job can trigger
# the booking/inquiry nudges. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# If blank, the endpoint still works but prints a WARN each run.
FOLLOWUPS_CRON_TOKEN=
# Max WhatsApp nudges per cron HTTP call (bounds outbound/run).
FOLLOWUPS_MAX_NUDGES_PER_RUN=50

# ---------------------------------------------------------------------------
# 5. Cal.com — booking link + optional booking-created webhook handling
# ---------------------------------------------------------------------------
# Shareable booking URL the assistant drops when a buyer wants to talk 1:1.
CAL_COM_BOOKING_LINK=https://cal.com/petrobindglobal/30min

# Cal.com API key (optional, used only if we later auto-create events).
# Get from Cal.com → Settings → Developer → API keys.
CAL_COM_API_KEY=cal_live_REPLACE_WITH_YOUR_CAL_COM_API_KEY_OR_LEAVE_BLANK_MVP

# (Optional) signing secret for POST /cal-webhook — set it once you enable
# the webhook in Cal.com. If blank, the webhook still logs + notifies, but
# does not verify signatures (acceptable for MVP with <50 bookings/month).
#
# HOW TO GET THE VALUE (Cal.com Webhooks UI):
#   1. Cal.com → avatar top-right → Settings → Developer → Webhooks →
#      + New webhook. Subscriber URL =
#        https://whatsapp-webhook-gateway-e08w.onrender.com/cal-webhook
#      Tick ONLY ✅ Booking created. Active = ON.
#   2. Click Save. On save, Cal.com shows ONE flash toast at top with the
#      secret — copy/paste it NOW (you won't see it again in plain text).
#   3. If you missed the toast, the list view next to your webhook shows
#      only Edit + Delete icons. 👉 Click Edit (pencil icon), then inside
#      the modal look for 🔄 "Rotate signing secret" (or Regenerate) —
#      click it and the NEW secret is displayed ONCE. Copy + paste below.
#   4. OR: Leave blank = signature check skipped = simpler for MVP.
CAL_COM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 6. OPTIONAL — Shared Inbox (Human + AI co-pilot browser UI)
#    Skip this entire section for MVP — Petrobind WhatsApp works 100% without it.
#    When enabled, adds /inbox/chats login UI + /api/inbox/* REST co-pilot.
#    Upstash Redis + in-memory remain the PRIMARY session store for AI replies;
#    this Supabase layer is an additive, write-only, fire-and-forget mirror
#    specifically for rendering the shared inbox thread UI.
# ---------------------------------------------------------------------------
#
# 6a. (REQUIRED for inbox) Supabase project — Singapore (ap-southeast-1) ONLY
#     (PDPA / SEA data residency for Petrobind buyer numbers).
#     Create: https://supabase.com/dashboard/new → Region: Singapore (ap-southeast-1)
#     Project name: petrobind-global-shared-inbox (or staging variant).
#     After create: Project Settings → Database → Extensions → enable pgcrypto.
#     SQL Editor → paste run: supabase/migrations/0001_petrobind_shared_inbox.sql
#     Project Settings → Database → Replication → publication "supabase_realtime" →
#       toggle messages / inbox_claims / sessions tables ON (optional; poll fallback exists).
#     Project Settings → API → Copy "Project URL" + "service_role" secret (NOT the anon key).
#
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...SERVICE_ROLE...COPY_FROM_SUPABASE_DASHBOARD_API_PAGE_NOT_ANON
#
# (Optional for Realtime in-browser only, not required for REST) Anon key:
SUPABASE_ANON_KEY=eyJhbGciOi...ANON_PUBLIC...COPY_FROM_SUPABASE_DASHBOARD_API_PAGE
#
# 6b. (REQUIRED for inbox) Single admin password gates both /inbox/* HTML pages
#     AND /api/inbox/* bearer auth. Generate:
#       python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
INBOX_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_32CHARS_FROM_SECRETS_TOKEN_URLSAFE
#
# 6c. (Optional) Cookie signing key. If unset, derived from INBOX_ADMIN_TOKEN.
#     If you rotate INBOX_ADMIN_TOKEN and want existing inbox_session cookies
#     to still be valid until their max_age, set this to a separate secret instead.
INBOX_COOKIE_SIGNING_KEY=
#
# 6d. (Optional) Display name shown in the inbox UI when you claim a chat + in
#     audit_events. Defaults to "Petrobind Admin" if unset.
INBOX_ADMIN_NAME=Petrobind Admin
#
# 6e. (Optional) Inbox session cookie TTL in minutes. Defaults to 60 (1 hour).
INBOX_SESSION_EXPIRE_MINUTES=60
#
# 6f. (REQUIRED for scheduled-followups cron) Bearer token for the 2 cron routes:
#     POST /followups-scan  (idle buyer nudge + quiet-window deferral)
#     POST /scheduled-send-flush  (drains deferred quiet-window nudge rows after
#       their next eligible business day 07:00 buyer-local slot arrives)
#     Generate ONCE and paste the SAME value into both Render env AND the
#     external cron job (cron-job.org / Render Scheduled Jobs / GitHub Actions):
#       python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#     ⚠️  THIS TOKEN IS NEW (v2026.10 follow-ups scheduler) — 99% chance it is
#         NOT set today. DO NOT set it to the same value as INBOX_ADMIN_TOKEN
#         unless you want the inbox UI password to also double as cron auth.
FOLLOWUPS_CRON_TOKEN=REPLACE_WITH_LONG_RANDOM_32CHARS_GENERATED_BY_THE_PYTHON_ONE_LINER_ABOVE
#
# 6g. (Optional) Weekend send behaviour for quiet-window deferred follow-ups:
#     - false = DEFAULT (recommended). Buyer local weekday check applied PER
#       COUNTRY: (Sat-Sun 5,6) for SG/AU/US/EU/UK/IN + most of the world;
#       (Fri-Sat 4,5) for AE/SA/KW/QA/OM/JO/EG/DZ/TR/IR Middle East.
#       Nudge lands inside a country weekend → pushed to next workday 07:00.
#     - true  = DISABLE the weekend skip entirely. Only the 22:00–07:00 quiet
#       window is enforced, and every calendar day (Sat/Sun/Fri) is treated as
#       an eligible business day.
#     For Petrobind bitumen buyers (B2B, office hours Mon–Fri global default):
#     keep false. Set true only during holiday campaigns where weekend nudges
#     are explicitly allowed by the sales team.
FOLLOWUPS_WEEKEND_SENDS_OK=false

